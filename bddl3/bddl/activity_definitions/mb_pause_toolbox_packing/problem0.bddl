(define (problem mb_pause_toolbox_packing-0)
    (:domain behavior-1k)
    (:objects
        breakfast_table.n.01_1 - breakfast_table.n.01
        toolbox.n.01_1 toolbox.n.01_2 - toolbox.n.01
        drill.n.01_1 - drill.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop toolbox.n.01_1 breakfast_table.n.01_1)
        (ontop toolbox.n.01_2 breakfast_table.n.01_1)
        (ontop drill.n.01_1 breakfast_table.n.01_1)
        (open toolbox.n.01_1)
        (not (open toolbox.n.01_2))
        (inroom breakfast_table.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?toolbox.n.01_1 ?breakfast_table.n.01_1)
            (ontop ?toolbox.n.01_2 ?breakfast_table.n.01_1)
            (ontop ?drill.n.01_1 ?breakfast_table.n.01_1)
            (not (open ?toolbox.n.01_1))
            (not (open ?toolbox.n.01_2))
        )
    )
)
