(define (problem mb_bring_breakfast_cup-0)
    (:domain behavior-1k)
    (:objects
        countertop.n.01_1 countertop.n.01_2 - countertop.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        coffee_cup.n.01_1 - coffee_cup.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop coffee_cup.n.01_1 countertop.n.01_1)
        (inroom countertop.n.01_1 kitchen)
        (inroom countertop.n.01_2 kitchen)
        (inroom breakfast_table.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?coffee_cup.n.01_1 ?breakfast_table.n.01_1)
        )
    )
)
