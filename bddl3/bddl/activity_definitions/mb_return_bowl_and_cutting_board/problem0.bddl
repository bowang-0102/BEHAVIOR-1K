(define (problem mb_return_bowl_and_cutting_board-0)
    (:domain behavior-1k)
    (:objects
        bowl.n.01_1 - bowl.n.01
        vessel.n.03_1 - vessel.n.03
        chopping_board.n.01_1 - chopping_board.n.01
        countertop.n.01_1 countertop.n.01_2 countertop.n.01_3 - countertop.n.01
        shelf.n.01_1 shelf.n.01_2 - shelf.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop bowl.n.01_1 countertop.n.01_1)
        (ontop vessel.n.03_1 countertop.n.01_1)
        (ontop chopping_board.n.01_1 countertop.n.01_1)
        (inroom countertop.n.01_1 kitchen)
        (inroom countertop.n.01_2 kitchen)
        (inroom countertop.n.01_3 kitchen)
        (inroom shelf.n.01_1 kitchen)
        (inroom shelf.n.01_2 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?bowl.n.01_1 ?shelf.n.01_1)
            (ontop ?vessel.n.03_1 ?countertop.n.01_1)
            (ontop ?chopping_board.n.01_1 ?countertop.n.01_2)
        )
    )
)
