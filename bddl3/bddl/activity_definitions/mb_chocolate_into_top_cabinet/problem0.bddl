(define (problem mb_chocolate_into_top_cabinet-0)
    (:domain behavior-1k)

    (:objects
        chocolate_bar.n.01_1 - chocolate_bar.n.01
        cabinet.n.01_1 cabinet.n.01_2 - cabinet.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop chocolate_bar.n.01_1 breakfast_table.n.01_1)
        (not (open cabinet.n.01_1))
        (not (open cabinet.n.01_2))
        (inroom cabinet.n.01_1 kitchen)
        (inroom cabinet.n.01_2 kitchen)
        (inroom breakfast_table.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside ?chocolate_bar.n.01_1 ?cabinet.n.01_1)
            (forall
                (?cabinet.n.01 - cabinet.n.01)
                (not (open ?cabinet.n.01))
            )
        )
    )
)
