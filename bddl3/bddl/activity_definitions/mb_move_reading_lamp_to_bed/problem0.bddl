(define (problem mb_move_reading_lamp_to_bed-0)
    (:domain behavior-1k)
    (:objects
        flashlight.n.01_1 - flashlight.n.01
        desk.n.01_1 - desk.n.01
        bed.n.01_1 - bed.n.01
        bookcase.n.01_1 - bookcase.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop flashlight.n.01_1 desk.n.01_1)
        (inroom desk.n.01_1 bedroom)
        (inroom bed.n.01_1 bedroom)
        (inroom bookcase.n.01_1 bedroom)
        (inroom floor.n.01_1 bedroom)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?flashlight.n.01_1 ?bed.n.01_1)
            (not (toggled_on ?flashlight.n.01_1))
        )
    )
)
