(define (problem mb_putting_hamburger_in_microwave-0)
    (:domain behavior-1k)
    (:objects
        hamburger.n.01_1 - hamburger.n.01
        countertop.n.01_1 countertop.n.01_2 countertop.n.01_3 - countertop.n.01
        microwave.n.02_1 - microwave.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop hamburger.n.01_1 countertop.n.01_3)
        (not (open microwave.n.02_1))
        (inroom countertop.n.01_1 kitchen)
        (inroom countertop.n.01_2 kitchen)
        (inroom countertop.n.01_3 kitchen)
        (inroom microwave.n.02_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (inside ?hamburger.n.01_1 ?microwave.n.02_1)
            (not (open ?microwave.n.02_1))
        )
    )
)
