(define (problem mb_return_book_to_original_bookcase-0)
    (:domain behavior-1k)
    (:objects
        hardback.n.01_1 - hardback.n.01
        bookcase.n.01_1 bookcase.n.01_2 bookcase.n.01_3 bookcase.n.01_4 - bookcase.n.01
        desk.n.01_1 - desk.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop hardback.n.01_1 desk.n.01_1)
        (inroom bookcase.n.01_1 living_room)
        (inroom bookcase.n.01_2 living_room)
        (inroom bookcase.n.01_3 living_room)
        (inroom bookcase.n.01_4 living_room)
        (inroom desk.n.01_1 living_room)
        (inroom floor.n.01_1 living_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?hardback.n.01_1 ?bookcase.n.01_1)
        )
    )
)
