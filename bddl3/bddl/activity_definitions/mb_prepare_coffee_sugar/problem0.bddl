(define (problem mb_prepare_coffee_sugar-0)
    (:domain behavior-1k)
    (:objects
        cabinet.n.01_1 cabinet.n.01_2 - cabinet.n.01
        countertop.n.01_1 countertop.n.01_2 countertop.n.01_3 - countertop.n.01
        coffee_cup.n.01_1 - coffee_cup.n.01
        jar__of__sugar.n.01_1 - jar__of__sugar.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop coffee_cup.n.01_1 countertop.n.01_3)
        (inside jar__of__sugar.n.01_1 cabinet.n.01_1)
        (not (open cabinet.n.01_1))
        (not (open cabinet.n.01_2))
        (inroom cabinet.n.01_1 kitchen)
        (inroom cabinet.n.01_2 kitchen)
        (inroom countertop.n.01_1 kitchen)
        (inroom countertop.n.01_2 kitchen)
        (inroom countertop.n.01_3 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?coffee_cup.n.01_1 ?countertop.n.01_3)
            (ontop ?jar__of__sugar.n.01_1 ?countertop.n.01_3)
            (not (open ?cabinet.n.01_1))
            (not (open ?cabinet.n.01_2))
        )
    )
)
