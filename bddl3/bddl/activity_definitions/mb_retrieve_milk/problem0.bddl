(define (problem mb_retrieve_milk-0)
    (:domain behavior-1k)
    (:objects
        bottle__of__milk.n.01_1 - bottle__of__milk.n.01
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        microwave.n.02_1 - microwave.n.02
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        ; Sample a refrigerator template; MemoryTask declares each variant's Query entry.
        (inside bottle__of__milk.n.01_1 electric_refrigerator.n.01_1)
        (not (open electric_refrigerator.n.01_1))
        (not (open microwave.n.02_1))
        (not (toggled_on microwave.n.02_1))
        (inroom electric_refrigerator.n.01_1 kitchen)
        (inroom microwave.n.02_1 kitchen)
        (inroom breakfast_table.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?bottle__of__milk.n.01_1 ?breakfast_table.n.01_1)
            (not (open ?electric_refrigerator.n.01_1))
            (not (open ?microwave.n.02_1))
            (not (toggled_on ?microwave.n.02_1))
        )
    )
)
