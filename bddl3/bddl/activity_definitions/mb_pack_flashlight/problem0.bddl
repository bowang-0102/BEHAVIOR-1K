(define (problem mb_pack_flashlight-0)
    (:domain behavior-1k)
    (:objects
        cabinet.n.01_1 cabinet.n.01_2 - cabinet.n.01
        tabletop.n.01_1 - tabletop.n.01
        packing_box.n.02_1 - packing_box.n.02
        flashlight.n.01_1 - flashlight.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop packing_box.n.02_1 tabletop.n.01_1)
        (ontop flashlight.n.01_1 tabletop.n.01_1)
        (not (open cabinet.n.01_1))
        (not (open cabinet.n.01_2))
        (inroom cabinet.n.01_1 utility_room)
        (inroom cabinet.n.01_2 utility_room)
        (inroom tabletop.n.01_1 utility_room)
        (inroom floor.n.01_1 utility_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?packing_box.n.02_1 ?tabletop.n.01_1)
            (inside ?flashlight.n.01_1 ?packing_box.n.02_1)
            (not (open ?cabinet.n.01_1))
            (not (open ?cabinet.n.01_2))
        )
    )
)
