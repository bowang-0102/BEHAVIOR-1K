(define (problem mb_place_previously_used_radio_on_tv_stand-0)
    (:domain behavior-1k)
    (:objects
        radio_receiver.n.01_1 - radio_receiver.n.01
        receiver.n.01_1 - receiver.n.01
        coffee_table.n.01_1 - coffee_table.n.01
        cabinet.n.01_1 - cabinet.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop radio_receiver.n.01_1 coffee_table.n.01_1)
        (ontop receiver.n.01_1 coffee_table.n.01_1)
        (not (toggled_on radio_receiver.n.01_1))
        (not (toggled_on receiver.n.01_1))
        (inroom coffee_table.n.01_1 living_room)
        (inroom cabinet.n.01_1 living_room)
        (inroom floor.n.01_1 living_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?radio_receiver.n.01_1 ?cabinet.n.01_1)
            (ontop ?receiver.n.01_1 ?coffee_table.n.01_1)
            (not (toggled_on ?radio_receiver.n.01_1))
            (not (toggled_on ?receiver.n.01_1))
        )
    )
)
