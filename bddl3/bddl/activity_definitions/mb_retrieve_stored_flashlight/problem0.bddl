(define (problem mb_retrieve_stored_flashlight-0)
    (:domain behavior-1k)
    (:objects
        desk.n.01_1 - desk.n.01
        toolbox.n.01_1 toolbox.n.01_2 - toolbox.n.01
        flashlight.n.01_1 - flashlight.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop toolbox.n.01_1 desk.n.01_1)
        (ontop toolbox.n.01_2 desk.n.01_1)
        (inside flashlight.n.01_1 toolbox.n.01_1)
        (not (open toolbox.n.01_1))
        (not (open toolbox.n.01_2))
        (inroom desk.n.01_1 bedroom)
        (inroom floor.n.01_1 bedroom)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop ?toolbox.n.01_1 ?desk.n.01_1)
            (ontop ?toolbox.n.01_2 ?desk.n.01_1)
            (ontop ?flashlight.n.01_1 ?desk.n.01_1)
            (not (open ?toolbox.n.01_1))
            (not (open ?toolbox.n.01_2))
        )
    )
)
